# ─────────────────────────────────────────────
# 공개 저장소 규칙: 비밀 정보와 실제 데이터는 절대 올리지 않는다
# ─────────────────────────────────────────────

# 비밀 정보 (비밀번호·암호화 키·DB 접속 정보) → .env.example만 올린다
.env
.env.*
!.env.example

# DB 데이터, 백업, 업로드 파일, 로그 (학생 명단·출석 기록이 들어 있음)
data/
backups/
uploads/
logs/
*.dump
*.sql.gz
*.backup
apps/api/.dev-db/

# 실제 명단 엑셀을 실수로 올리지 않도록 (템플릿은 apps/api/templates 아래만 허용)
*.xlsx
*.xls
*.csv
!apps/api/templates/*.xlsx
!docs/*.xlsx

# 빌드 결과와 패키지
node_modules/
dist/
coverage/
*.tsbuildinfo
apps/web/dev-dist/

# 편집기·OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
.claude/
