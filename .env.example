# ─────────────────────────────────────────────
# 서버 PC에서는 자동으로 만든다:  powershell -ExecutionPolicy Bypass -File scripts\make-env.ps1
# (직접 만들 때는 이 파일을 복사해 .env를 만들고 값을 채운다:  copy .env.example .env)
# .env는 저장소에 올라가지 않는다 (.gitignore). 이 파일에는 절대 실제 값을 적지 않는다.
# ─────────────────────────────────────────────

# 실행 모드: production(서버 PC) / development(개발 PC)
NODE_ENV=production

# 암호화 키: 이메일 비밀번호·OTP 비밀키 암호화, 학교 코드·기기 해시에 쓴다.
# 아무도 모르는 긴 문자열(48자 이상). scripts\make-env.ps1이 만들어 준다.
# 한 번 정하면 바꾸지 않는다 (바꾸면 저장된 이메일 비밀번호·OTP를 다시 등록해야 함).
APP_SECRET=

# 관리자 포트 확인용 비밀 값 (Nginx 관리자 입구만 이 값을 API에 넘긴다). 위와 같은 방법으로 만든다.
ADMIN_GATE_SECRET=

# PostgreSQL 비밀번호 (Docker 안에서만 쓰임). 위와 같은 방법으로 만든다.
POSTGRES_PASSWORD=

# 공개 주소 (Tailscale Funnel). 예: https://office-pc.tail1234.ts.net  ← 실제 주소는 .env에만 적는다
PUBLIC_URL=

# 개발 PC에서만 쓰는 값 (Docker 없이 실행할 때)
# DATABASE_URL=postgresql://postgres:postgres@localhost:54329/coss
# REDIS_URL=            (비워 두면 메모리에 저장 → 개발·테스트용)
