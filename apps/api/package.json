{
  "name": "@coss/api",
  "version": "1.0.0",
  "private": true,
  "description": "출석체크 API 서버와 Worker (NestJS)",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:dev": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:demo": "node --env-file=.env scripts/seed-demo.mjs",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@prisma/client": "~6.19.0",
    "bcryptjs": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "nodemailer": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "16.14.0-beta.17",
    "jest": "^29.7.0",
    "prisma": "~6.19.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.0"
  }
}
